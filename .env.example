NODE_ENV=development
PORT=3000
SWAGGER_ENABLED=true
DATABASE_URL=postgresql://facturify:facturify@localhost:5432/facturify?schema=public
JWT_SECRET=replace-with-a-long-random-secret-before-production
BOOTSTRAP_ADMIN_TOKEN=replace-with-a-separate-long-random-bootstrap-token
SECRETS_ENCRYPTION_KEY=replace-with-32-byte-base64-encoded-key
DOCUMENT_STORAGE_PATH=storage/documents
CERTIFICATES_STORAGE_PATH=storage/certificates
CERTIFICATE_MAX_SIZE_BYTES=512000
STORAGE_MAX_XML_BYTES=5242880
STORAGE_MAX_ZIP_BYTES=15728640
STORAGE_MAX_CDR_BYTES=5242880
SUNAT_TIMEOUT_MS=30000
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=20
